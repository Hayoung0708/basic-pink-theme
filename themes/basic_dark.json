    "colors": {
        "statusBar.background": "#F2788C",
        "statusBar.foreground": "#1E1E1E",
        "statusBar.border": "#F2788C",
        "statusBarItem.hoverBackground": "#00000026",
        "statusBarItem.activeBackground": "#00000040",
        "statusBar.noFolderBackground": "#D9647A",

        "button.background": "#F2788C",
        "button.foreground": "#1E1E1E",
        "button.hoverBackground": "#FF93A4",
        "progressBar.background": "#F2788C",
        "focusBorder": "#F2788C",
        "activityBarBadge.background": "#F2788C",
        "activityBarBadge.foreground": "#1E1E1E",

        "notificationsInfoIcon.foreground": "#F2788C",
        "notificationLink.foreground": "#F2788C",
        "textLink.foreground": "#F2788C",
        "textLink.activeForeground": "#FF93A4"
    },
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "newOperator": "#B67CAB",
        "stringLiteral": "#E3BAD2",
        "customLiteral": "#E5DDDB",
        "numberLiteral": "#FFD6DA"
    }
